# Copy this file to .env (same folder) and fill in - or just run: python check_setup.py
# NEVER commit .env (it is in .gitignore).

# ---- AI model -------------------------------------------------------------
# hosted = real AI with your key
# mock   = built-in demo answers, no key, no internet (backup / tests)
# replay = reuse answers saved from an earlier hosted run (no tokens used)
LLM_MODE=hosted

# OpenAI (default). Key from https://platform.openai.com/api-keys (starts with sk-)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Fast and good for code. scripts/test_llm.py --fix picks another if your key cannot use it.
LLM_MODEL=gpt-4.1-mini
# Only for reasoning models (o-series / gpt-5...): low = faster. Leave empty for gpt-4.1-mini.
LLM_REASONING_EFFORT=

# Google Gemini instead:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-flash-latest
# GEMINI_AUTH=api_key

LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300
# Save every AI answer in SQLite and reuse it for identical questions (saves tokens)
LLM_CACHE=true

# ---- Test engine ------------------------------------------------------------
# local  = run checks with this machine's Python (time limit, no secrets in env)
# docker = run checks in a container with no network (build runner image first, see README)
RUNNER_MODE=local
RUNNER_IMAGE=sdlc-runner:latest

# ---- Optional OpenAI extras ---------------------------------------------------
# Models tried in order if LLM_MODEL is not available to your key:
LLM_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o-mini,gpt-4.1,gpt-4o,gpt-5-mini,gpt-5
# Only if your key belongs to several organizations / projects:
LLM_ORGANIZATION=
LLM_PROJECT=
